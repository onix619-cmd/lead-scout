# Required: Google Places API key (enable "Places API (New)" in Google Cloud Console)
GOOGLE_PLACES_API_KEY=

# Required for AI-generated website content. Get one at
# https://aistudio.google.com/apikey — note: you must also link billing on
# the Google Cloud project (see README) or you'll get quota errors, even
# though usage within free limits costs $0.
GEMINI_API_KEY=

# Required for auto-deploying generated sites to Vercel — free, get one at
# https://vercel.com/account/tokens
VERCEL_API_TOKEN=
# Only needed if your Vercel account/token is under a Team, not personal
VERCEL_TEAM_ID=

# Optional: only needed for "Save to CRM" and to store generated site URLs
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
